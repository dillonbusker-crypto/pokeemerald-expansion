@ Shared continuation for every pool battle in every gauntlet. Reached
@ whether the battle was won or lost - see the IsPlayerDefeated() branch in
@ src/battle_setup.c's CB2_EndTrainerBattle, patched to resume the script
@ instead of whiting out while IsFacilityRunActive().
Facility_AfterPoolBattle:
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_WON, Facility_Lost
	special HealPlayerParty
	special RestoreFacilityHeldItems
	special FacilityGetBattleWonInfo
	copyvar VAR_TEMP_5, VAR_RESULT
	buffernumberstring STR_VAR_2, VAR_0x8008
	special FacilityAwardBattleFP
	special FacilityAdvanceBattleNum
	call Common_EventScript_SaveGame
	msgbox Facility_Text_BattleWon, MSGBOX_DEFAULT
	goto_if_eq VAR_TEMP_5, TRUE, Facility_BossUpNext
	goto Facility_PostWinMenu
	end

Facility_BossUpNext:
	msgbox Facility_Text_BossUpNext, MSGBOX_DEFAULT
	goto Facility_PostWinMenu
	end

@ Ten Gauntlets: only offered between pool battles, not after the boss -
@ "Continue" has nothing left to continue to once the gauntlet's cleared,
@ so Facility_AfterBossBattle below goes straight to the gauntlet-complete
@ message instead of here.
Facility_PostWinMenu:
	setvar VAR_0x8004, SCROLL_MULTI_TEN_GAUNTLETS_POST_BATTLE
	special ShowScrollableMultichoice
	switch VAR_RESULT
	case 0, Facility_DoBattle
	case 1, Facility_RearrangeParty
	case 2, Facility_ConfirmQuit
	case MULTI_B_PRESSED, Facility_DoBattle
	end

@ A real swap of the Pokemon data, not just a lead pick - see
@ FacilitySwapPartyMonSlots() in src/facility.c for why. One swap per visit
@ to this menu; picking "Rearrange Party" again from Facility_PostWinMenu
@ does another.
Facility_RearrangeParty:
	msgbox Facility_Text_ChooseMonToMove, MSGBOX_DEFAULT
	special ChoosePartyMon
	goto_if_ge VAR_0x8004, PARTY_SIZE, Facility_PostWinMenu
	copyvar VAR_TEMP_4, VAR_0x8004
	msgbox Facility_Text_ChooseMonToSwapWith, MSGBOX_DEFAULT
	special ChoosePartyMon
	goto_if_ge VAR_0x8004, PARTY_SIZE, Facility_PostWinMenu
	copyvar VAR_0x8005, VAR_0x8004
	copyvar VAR_0x8004, VAR_TEMP_4
	special FacilitySwapPartyMonSlots
	msgbox Facility_Text_SwappedMons, MSGBOX_DEFAULT
	goto Facility_PostWinMenu
	end

@ Ten Gauntlets: no re-entry once a gauntlet is cleared (CLAUDE.md).
@ Ten Gauntlets: STEVEN's event (frontier-dialogue.md). JUAN has one line for
@ his old student WALLACE, then the attendant points the player to the Hall
@ of Ten.
Facility_B2_GauntletComplete:
	msgbox Facility_B2_Text_JuanApology, MSGBOX_DEFAULT
	msgbox Facility_Text_GauntletComplete, MSGBOX_DEFAULT
	call_if_eq VAR_STEVEN_STORY_STATE, 0, Facility_B2_StevenHook
	releaseall
	end

Facility_B2_StevenHook:
	msgbox Facility_B2_Text_StevenHook, MSGBOX_DEFAULT
	setvar VAR_STEVEN_STORY_STATE, 1
	return

@ Ten Gauntlets: gauntlet 3 stays shut until the player has met STEVEN in
@ the Hall of Ten (VAR_STEVEN_STORY_STATE 2). The mat only opens once
@ gauntlet 2 is cleared, so a save from before the hook existed (state 0)
@ is held here too, and the Hall still has STEVEN waiting for it.
Facility_B3_StevenWaiting:
	msgbox Facility_B3_Text_StevenWaiting, MSGBOX_DEFAULT
	release
	end

Facility_B4_StevenHook:
	msgbox Facility_B4_Text_StevenHook, MSGBOX_DEFAULT
	return

Facility_B1_Commotion:
	msgbox Facility_B1_Text_Commotion, MSGBOX_DEFAULT
	setvar VAR_NORMAN_STORY_STATE, 1
	return

@ Ten Gauntlets: NORMAN has told the Doubles mat attendant not to let the
@ player through. Until he's beaten outside the Tower, gauntlet 2 stays shut.
@ Only reached with gauntlet 1 cleared and gauntlet 2 not, so a save that
@ cleared gauntlet 1 before this storyline existed still gets it.
Facility_B2_NormanBlock:
	msgbox Facility_B2_Text_NormanCameIn, MSGBOX_DEFAULT
	call_if_lt VAR_NORMAN_STORY_STATE, 2, Facility_B2_HeardAboutNorman
	release
	end

Facility_B2_HeardAboutNorman:
	setvar VAR_NORMAN_STORY_STATE, 2
	return

@ Ten Gauntlets: gauntlet 4 stays shut until the Artisan Cave quest is done
@ (IsFrontierPOSDown). The hint points at the Old Woman by the odd tree, whose
@ rumor leads to FLOTSAM.
Facility_B4_POSDown:
	goto_if_set FLAG_ARTISAN_LATI_CAUGHT, Facility_B4_POSDownLooker
	msgbox Facility_B4_Text_POSDown, MSGBOX_DEFAULT
	release
	end

@ After the catch, the system stays down until the player collects the
@ SCRAMBLER from LOOKER, who now stands where FLOTSAM did.
Facility_B4_POSDownLooker:
	msgbox Facility_B4_Text_POSDownLooker, MSGBOX_DEFAULT
	release
	end

Facility_AlreadyCleared:
	msgbox Facility_Text_AlreadyCleared, MSGBOX_DEFAULT
	release
	end

Facility_ConfirmQuit:
	msgbox Facility_Text_ConfirmQuit, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Facility_PostWinMenu
	goto_if_eq VAR_RESULT, MULTI_B_PRESSED, Facility_PostWinMenu
	special FacilityAbandonRun
	call Common_EventScript_SaveGame
	msgbox Facility_Text_QuitConfirmed, MSGBOX_DEFAULT
	releaseall
	end

Facility_AfterBossBattle:
	specialvar VAR_RESULT, GetBattleOutcome
	goto_if_ne VAR_RESULT, B_OUTCOME_WON, Facility_Lost
	special HealPlayerParty
	special RestoreFacilityHeldItems
	special GetFacilityRunGauntlet
	copyvar VAR_TEMP_2, VAR_RESULT
	special FacilityCompleteGauntlet
	goto_if_eq VAR_TEMP_2, FACILITY_GAUNTLET_4, Facility_B4_GauntletComplete
	call Common_EventScript_SaveGame
	goto_if_eq VAR_TEMP_2, FACILITY_GAUNTLET_1, Facility_B1_GauntletComplete
	goto_if_eq VAR_TEMP_2, FACILITY_GAUNTLET_2, Facility_B2_GauntletComplete
	goto_if_eq VAR_TEMP_2, FACILITY_GAUNTLET_5, Facility_B5_GauntletComplete
	msgbox Facility_Text_GauntletComplete, MSGBOX_DEFAULT
	releaseall
	end

@ Ten Gauntlets: clearing gauntlet 5 opens the Battle Factory (gauntlet 6,
@ see IsBattleFactoryUnlocked() in src/facility.c) and new Mega Stones. No
@ item to hand over - the Mega Ring came with gauntlet 4.
Facility_B5_GauntletComplete:
	msgbox Facility_B5_Text_GauntletComplete, MSGBOX_DEFAULT
	releaseall
	end

@ Ten Gauntlets: clearing gauntlet 4 hands over the Mega Ring - without it
@ the player can't Mega Evolve at all (CanMegaEvolve() in
@ src/battle_util.c checks the bag for it) - and points the player at the
@ two things that just opened: the Mega Stone counter and the Battle Dome
@ (gauntlet 5, see IsBattleDomeUnlocked() in src/facility.c). The ring is
@ given BEFORE the save, so a completed gauntlet 4 is never saved without
@ it. The Mega Stone keeper also re-gives it if it's ever missing - see
@ BattleFrontier_ExchangeServiceCorner_EventScript_MegaStoneKeeper.
Facility_B4_GauntletComplete:
	msgbox Facility_B4_Text_GauntletComplete, MSGBOX_DEFAULT
	giveitem ITEM_MEGA_RING
	call Common_EventScript_SaveGame
	msgbox Facility_B4_Text_MegaStonesAndDome, MSGBOX_DEFAULT
	call_if_eq VAR_STEVEN_STORY_STATE, 2, Facility_B4_StevenHook
	releaseall
	end

Facility_B1_GauntletComplete:
	msgbox Facility_B1_Text_GauntletComplete, MSGBOX_DEFAULT
	@ Ten Gauntlets: NORMAN's storyline starts here (frontier-dialogue.md).
	call_if_eq VAR_NORMAN_STORY_STATE, 0, Facility_B1_Commotion
	releaseall
	end

@ Ten Gauntlets: heals and restores held items on a loss too, not just a
@ win - CLAUDE.md's "Full heal between every battle" applies regardless of
@ outcome. FP already earned and the run being over are unaffected either
@ way (FacilityAbandonRun doesn't touch FP - see run-loop-spec.md's
@ "Losing" section).
Facility_Lost:
	@ Ten Gauntlets: a SECOND WIND (Lounge 7) gives one retry of a lost
	@ battle - pool or boss - healed, same opponent, streak intact.
	checkitem ITEM_SECOND_WIND
	goto_if_eq VAR_RESULT, FALSE, Facility_LostForGood
	msgbox Facility_Text_UseSecondWind, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, Facility_LostForGood
	removeitem ITEM_SECOND_WIND
	special HealPlayerParty
	special RestoreFacilityHeldItems
	msgbox Facility_Text_SecondWindUsed, MSGBOX_DEFAULT
	goto Facility_DoBattle
	end

Facility_LostForGood:
	special HealPlayerParty
	special RestoreFacilityHeldItems
	special FacilityAbandonRun
	special FacilitySilentSave
	msgbox Facility_Text_Lost, MSGBOX_DEFAULT
	releaseall
	end


Facility_Text_AskEnter:
